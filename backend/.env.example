CORS_ORIGINS=["http://localhost:3000"]
# Optional: used only when the copilot phase is implemented.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional live market-research model. The API key stays server-side.
OPENAI_MODEL=gpt-5.4-mini
# RESEARCH_DOMAINS may override the default primary-source host allowlist as a JSON array.

# Supabase publishable key only (never service-role). Required for project storage.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Set true for public deployment. Local unauthenticated engineering mode defaults false.
REQUIRE_AUTH=false
